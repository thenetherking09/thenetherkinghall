{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    { "src": "/api/telegram", "dest": "/api/telegram.js" },
    { "src": "/oracle-story/(.*)", "dest": "/oracle-story/$1" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/favicon/(.*)", "dest": "/favicon/$1" },
    { "src": "/CSS/(.*)", "dest": "/CSS/$1" },
    { "src": "/JS/(.*)", "dest": "/JS/$1" },
    { "src": "/HTML/(.*)", "dest": "/HTML/$1" },
    { "src": "/", "dest": "/HTML/index.html" },
    { "src": "/contact", "dest": "/HTML/contact.html" },
    { "src": "/gallery", "dest": "/HTML/gallery.html" },
    { "src": "/oracle", "dest": "/HTML/oracle.html" },
    { "src": "/404", "dest": "/HTML/404.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/HTML/404.html" }
  ]
}